    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import Point, Line\r\nimport math\r\n\r\n# 1. Variables de Sliders\r\nL               = float(IN[0])\r\nU               = int(IN[1])\r\nV               = int(IN[2])\r\nnum_niveles     = max(1, int(IN[3]))\r\nfactor_grosor   = float(IN[4])\r\nflip            = int(IN[5])\r\ndiag_cruzadas   = int(IN[6])\r\nH_columna       = float(IN[7]) # Nuevo: Altura de columnas\r\nnum_cols_u      = int(IN[8]) # NUEVO: Apoyos en X\r\nnum_cols_v      = int(IN[9]) # NUEVO: Apoyos en Y\r\n\r\ndireccion_z = -1.0 if flip == 1 else 1.0\r\nH_base = L * (math.sqrt(2.0) / 2.0) * factor_grosor\r\n\r\n# 2. Generación de mallas\r\nmallas_puntos = []\r\nfor k in range(num_niveles + 1):\r\n    z_actual = k * H_base * direccion_z\r\n    capa_k = []\r\n    if k % 2 == 0:\r\n        for i in range(U + 1):\r\n            fila = []\r\n            for j in range(V + 1):\r\n                fila.append(Point.ByCoordinates(i * L, j * L, z_actual))\r\n            capa_k.append(fila)\r\n    else:\r\n        for i in range(U):\r\n            fila = []\r\n            for j in range(V):\r\n                fila.append(Point.ByCoordinates((i * L) + (L / 2.0), (j * L) + (L / 2.0), z_actual))\r\n            capa_k.append(fila)\r\n    mallas_puntos.append(capa_k)\r\n\r\n# 3. Clasificación de Armadura\r\ncuerdas_inferiores, cuerdas_superiores, cuerdas_intermedias = [], [], []\r\ndiagonales_espacio, diagonales_planas = [], []\r\n\r\nfor k in range(num_niveles + 1):\r\n    pts = mallas_puntos[k]\r\n    filas, columnas = len(pts), len(pts[0])\r\n    barras_capa = []\r\n    for i in range(filas - 1):\r\n        for j in range(columnas): barras_capa.append(Line.ByStartPointEndPoint(pts[i][j], pts[i+1][j]))\r\n    for i in range(filas):\r\n        for j in range(columnas - 1): barras_capa.append(Line.ByStartPointEndPoint(pts[i][j], pts[i][j+1]))\r\n    if diag_cruzadas == 1:\r\n        for i in range(filas - 1):\r\n            for j in range(columnas - 1):\r\n                diagonales_planas.append(Line.ByStartPointEndPoint(pts[i][j], pts[i+1][j+1]))\r\n                diagonales_planas.append(Line.ByStartPointEndPoint(pts[i+1][j], pts[i][j+1]))\r\n    \r\n    if k == 0: cuerdas_inferiores.extend(barras_capa)\r\n    elif k == num_niveles: cuerdas_superiores.extend(barras_capa)\r\n    else: cuerdas_intermedias.extend(barras_capa)\r\n\r\nfor k in range(num_niveles):\r\n    pts_inf, pts_sup = mallas_puntos[k], mallas_puntos[k + 1]\r\n    if k % 2 == 0:\r\n        for i in range(U):\r\n            for j in range(V):\r\n                cima = pts_sup[i][j]\r\n                for x, y in [(0,0), (1,0), (0,1), (1,1)]: diagonales_espacio.append(Line.ByStartPointEndPoint(cima, pts_inf[i+x][j+y]))\r\n    else:\r\n        for i in range(U):\r\n            for j in range(V):\r\n                base = pts_inf[i][j]\r\n                for x, y in [(0,0), (1,0), (0,1), (1,1)]: diagonales_espacio.append(Line.ByStartPointEndPoint(base, pts_sup[i+x][j+y]))\r\n\r\n# 4. Generación de Apoyos (Distribución paramétrica)\r\nejes_columnas = []\r\npuntos_cimentacion = []\r\n\r\n# 1. Asegurar la lectura de los Sliders\r\ntry:\r\n    num_cols_u = int(IN[8])\r\n    num_cols_v = int(IN[9])\r\nexcept:\r\n    # Si por alguna razón los sliders fallan, asignamos 3 para forzar una columna central\r\n    num_cols_u = 3 \r\n    num_cols_v = 3\r\n\r\n# Garantizar que al menos existan 2 columnas por eje\r\nnum_cols_u = max(2, num_cols_u)\r\nnum_cols_v = max(2, num_cols_v)\r\n\r\n# 2. CÁLCULO CORREGIDO: Se añade 'float()' para evitar el error de división entera de Python\r\nindices_u = [int(round(i * U / float(num_cols_u - 1))) for i in range(num_cols_u)]\r\nindices_v = [int(round(i * V / float(num_cols_v - 1))) for i in range(num_cols_v)]\r\n\r\n# Guardar las coordenadas (i, j)\r\napoyos_indices = []\r\n\r\nfor i in indices_u:\r\n    for j in indices_v:\r\n        apoyos_indices.append((i, j))\r\n\r\n# 3. Generar la geometría de columnas y zapatas\r\nfor i, j in apoyos_indices:\r\n    i_seguro = min(int(i), U)\r\n    j_seguro = min(int(j), V)\r\n    \r\n    try:\r\n        # Intento A: La matriz está estructurada como [X][Y]\r\n        p_base = mallas_puntos[0][i_seguro][j_seguro]\r\n    except:\r\n        # Intento B: Si la matriz fue generada como [Y][X] por Dynamo\r\n        p_base = mallas_puntos[0][j_seguro][i_seguro]\r\n        \r\n    # Calcular el punto en el suelo restando la altura de la columna\r\n    p_suelo = Point.ByCoordinates(p_base.X, p_base.Y, p_base.Z - H_columna)\r\n    \r\n    puntos_cimentacion.append(p_suelo)\r\n    ejes_columnas.append(Line.ByStartPointEndPoint(p_suelo, p_base))\r\n\r\n# 5. Salida unificada con 7 puertos\r\nOUT = [\r\n    cuerdas_inferiores, cuerdas_superiores, cuerdas_intermedias, \r\n    diagonales_espacio, diagonales_planas, \r\n    ejes_columnas, puntos_cimentacion\r\n]",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
